{
  "name": "siges-frontend",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "SIGES",
  "author": "Matheus Mota da Silva <matheus125_mota@hotmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:pwa": "quasar dev -m pwa",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "test:phone-mask": "node --test tests/brazilian-phone-mask.test.js",
    "test:plate-mask": "node --test tests/brazilian-vehicle-plate-mask.test.js",
    "test:brl-currency": "node --test tests/brl-currency.test.js",
    "test:date-format": "node --test tests/date-format.test.js",
    "test:accessible-buttons": "node --test tests/accessible-icon-buttons.test.js",
    "test:server-validation": "node --test tests/server-validation.test.js",
    "test:modals": "node ../../scripts/modal-responsive-test.cjs",
    "test:a11y": "node ../../scripts/accessibility-audit.cjs",
    "test:kanban-pagination": "node --test tests/kanban-pagination.test.js",
    "test:report-exports": "node --test tests/report-export-queue.test.js",
    "test:structure": "node --test tests/structural-refactor.test.js",
    "test:node": "node --test tests/*.test.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "npm run test:node && npm run test:unit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "pinia": "^3.0.1",
    "quasar": "^2.35.4",
    "vue": "^3.5.45",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.4.27",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.32",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
