# Substituir domínio, certificado e socket pela instalação real.
server {
    listen 80;
    server_name siges.example.org;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name siges.example.org;
    ssl_certificate /etc/letsencrypt/live/siges.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/siges.example.org/privkey.pem;
    root /var/www/siges/frontend/quasar/dist/spa;
    index index.html;
    client_max_body_size 55m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /index.html { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
    location = /api { rewrite ^ /index.php last; }
    location /api/ { rewrite ^ /index.php last; }
    location = /up { rewrite ^ /index.php last; }
    location /sanctum/ { rewrite ^ /index.php last; }
    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/siges/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/siges/public;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/siges-fpm.sock;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
