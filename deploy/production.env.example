APP_NAME=SIGES
APP_ENV=production
# Preserve a APP_KEY atual ao transportar os dados.
APP_KEY=
APP_DEBUG=false
APP_URL=https://siges.example.org
FRONTEND_URL=https://siges.example.org
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_DECAY_SECONDS=60
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siges
DB_USERNAME=siges_app
DB_PASSWORD=
DB_URL=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_TOKEN_EXPIRATION_MINUTES=480
SANCTUM_TOKEN_IDLE_TIMEOUT_MINUTES=120
SANCTUM_MAX_TOKENS_PER_USER=5
SANCTUM_PRUNE_EXPIRED_HOURS=24
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
NOTIFICATION_QUEUE=notifications
NOTIFICATION_QUEUE_TIMEOUT=120
NOTIFICATION_QUEUE_TRIES=3
NOTIFICATION_QUEUE_BACKOFF=60
# Configurar SMTP antes de ativar notificações por e-mail.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=suporte@example.org
MAIL_FROM_NAME=SIGES
# App Secret da aplicacao Meta. Nao confundir com o Verify Token do webhook.
WHATSAPP_BUSINESS_APP_SECRET=
# Obrigatorio antes de habilitar a integracao. Gere com: openssl rand -hex 32
WHATSAPP_BUSINESS_VERIFY_TOKEN=
