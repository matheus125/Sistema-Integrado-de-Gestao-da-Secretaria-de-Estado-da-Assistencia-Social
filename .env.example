APP_NAME=SIGES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://127.0.0.1:9000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_DECAY_SECONDS=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siges
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_TOKEN_EXPIRATION_MINUTES=480
SANCTUM_TOKEN_IDLE_TIMEOUT_MINUTES=120
SANCTUM_MAX_TOKENS_PER_USER=5
SANCTUM_PRUNE_EXPIRED_HOURS=24

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180
NOTIFICATION_QUEUE=notifications
NOTIFICATION_QUEUE_TRIES=3
NOTIFICATION_QUEUE_TIMEOUT=120
NOTIFICATION_QUEUE_BACKOFF=60
REPORT_EXPORT_DISK=local
REPORT_EXPORT_QUEUE=exports
REPORT_EXPORT_TIMEOUT=120
REPORT_EXPORT_EXPIRES_AFTER=60
REPORT_EXPORT_CSV_MAX_ROWS=10000
REPORT_EXPORT_XLSX_MAX_ROWS=5000
REPORT_EXPORT_PDF_MAX_ROWS=500
PAGINATION_MAX_PER_PAGE=100

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Produção SMTP (substitua no .env do servidor; nunca comite credenciais)
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.exemplo.gov.br
# MAIL_PORT=587
# MAIL_USERNAME=usuario-smtp
# MAIL_PASSWORD=senha-smtp
# MAIL_EHLO_DOMAIN=exemplo.gov.br
# MAIL_FROM_ADDRESS=suporte@exemplo.gov.br
# MAIL_FROM_NAME="SIGES - Help Desk"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# App Secret da aplicacao Meta. Nao confundir com o Verify Token do webhook.
WHATSAPP_BUSINESS_APP_SECRET=
# Gere um valor exclusivo com: openssl rand -hex 32
WHATSAPP_BUSINESS_VERIFY_TOKEN=

VITE_APP_NAME="${APP_NAME}"
